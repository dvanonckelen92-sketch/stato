---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroAnnotated from '../components/HeroAnnotated.astro';
import { SITE } from '../data/site';
import { businessNode, websiteNode, founderNode, faqNode } from '../data/schema';
import { homeFaq } from '../data/faq';

import pieterImg from '../assets/foto/pieter-wolfs-stato-buiten.jpg';
import detailImg from '../assets/foto/fotodocumentatie-tablet-detail.jpg';

const services = [
  {
    title: 'Ingaande plaatsbeschrijving',
    when: 'Begin van de huur',
    text: 'Elke ruimte wordt beschreven en gefotografeerd. Meterstanden en rookmelders komen er standaard bij, en het verslag kan samen met het huurcontract geregistreerd worden.',
    href: '/onze-diensten#ingaande-plaatsbeschrijving',
  },
  {
    title: 'Uitgaande plaatsbeschrijving',
    when: 'Einde van de huur',
    text: 'We leggen het pand naast de ingaande plaatsbeschrijving en noteren wat er veranderd is: schade, slijtage of iets dat ontbreekt.',
    href: '/onze-diensten#uitgaande-plaatsbeschrijving',
  },
  {
    title: 'Huurcheck',
    when: 'Tijdens de huur',
    text: 'Wordt het pand goed onderhouden? Hangen er rookmelders en werken ze? U krijgt een overzicht van wat we zagen.',
    href: '/onze-diensten#huurcheck',
  },
  {
    title: 'Opvolging van werken',
    when: 'Na herstellingen',
    text: "We kijken of de werken gebeurd zijn zoals afgesproken, met foto's erbij. Handig als u zelf niet ter plaatse kunt zijn.",
    href: '/onze-diensten#opvolging-van-werken',
  },
] as const;
---
<Base
  title="Plaatsbeschrijving in Limburg en Vlaams-Brabant"
  description="Plaatsbeschrijving met foto's van elke ruimte, voor huurders, verhuurders en makelaars in Limburg en Vlaams-Brabant. Vaste prijs, verslag binnen 24 uur."
  path="/"
  schema={[businessNode, websiteNode, founderNode, faqNode('/', homeFaq)]}
>
  <HeroAnnotated />

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Wat doet STATO voor u?</h2>
        <p class="lead">Vier soorten opdrachten, voor particulieren, verhuurders en vastgoedkantoren. Bij een sleuteloverdracht of een wissel van huurder nemen we ook de meterstanden van water, gas en elektriciteit op.</p>
      </div>
      <dl class="services">
        {services.map((s) => (
          <div class="services__row">
            <dt>
              <a href={s.href}>{s.title}</a>
              <span>{s.when}</span>
            </dt>
            <dd>{s.text}</dd>
          </div>
        ))}
      </dl>
      <p style="margin-top:24px"><a href="/onze-diensten">Alle diensten in detail</a> · <a href="/tarieven-werkwijze">Hoe de prijs werkt</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container split">
      <div>
        <h2>Wie komt er langs?</h2>
        <p>STATO is de zaak van Pieter Wolfs. Via vastgoedmakelaars rolde hij in het opmaken van plaatsbeschrijvingen, merkte dat hij het graag deed en begon voor zichzelf. U heeft één vast aanspreekpunt, ook na het plaatsbezoek als u nog een vraag of opmerking heeft.</p>
        <p>Vanuit Sint-Truiden werkt STATO in heel Limburg en Vlaams-Brabant. Waar uw pand ligt, maakt voor de prijs niets uit: er komen geen verplaatsingskosten bij.</p>
        <p>Vastgoedkantoren kunnen hun plaatsbeschrijvingen volledig uitbesteden, of STATO bellen wanneer de eigen planning vol zit. Meer daarover op de pagina <a href="/vastgoedprofessionals">voor vastgoedprofessionals</a>.</p>
        <div class="quotes quotes--inline">
          <figure class="quote">
            <blockquote><p>De plaatsbeschrijving door Stato was ongelooflijk gedetailleerd en professioneel. Het gaf ons volledige gemoedsrust bij de verhuur van onze woning.</p></blockquote>
            <figcaption>Sophie Mertens</figcaption>
          </figure>
          <figure class="quote">
            <blockquote><p>Pieter heeft ons geholpen met een snelle en efficiënte plaatsbeschrijving. De communicatie was uitstekend en het rapport was zeer duidelijk.</p></blockquote>
            <figcaption>Jan Van Dijck</figcaption>
          </figure>
        </div>
      </div>
      <div class="split__media split__media--tall">
        <Photo src={pieterImg} alt="Pieter Wolfs van STATO met een tablet bij een woning" width={560} height={700} sizes="(max-width: 860px) 92vw, 480px" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Hoe ziet een verslag van STATO eruit?</h2>
        <p>Na een inleiding en de algemene bepalingen volgt het pand ruimte per ruimte. Per ruimte beschrijven we de vier muren, de vloer en het plafond, en bij elke muur horen genummerde foto's. De straatzijde heet altijd de noordmuur, zodat iedereen weet over welke muur het gaat.</p>
        <p>Achteraan staan de meterstanden voor elektriciteit, gas en water en het aantal sleutels per deur. Wilt u het verslag snel hebben, dan krijgt u het digitaal binnen 24 uur na het plaatsbezoek.</p>
        <p>In het voorbeeldverslag zijn adres, namen en foto's weggehaald. De opbouw is dezelfde als in een echt verslag.</p>
        <div class="actions">
          <a class="btn btn--primary" href={SITE.sampleReport}><Icon name="download" size={18} /> Voorbeeldverslag (pdf)</a>
        </div>
      </div>
      <div>
        <div class="report" aria-hidden="true">
          <div class="report__head"><strong>Plaatsbeschrijving aanvang huur</strong><span>STATO</span></div>
          <div class="report__row"><b>Inkomhal</b><span><span class="report__tag">Noordmuur · foto 1 tot 3</span><span class="report__tag">Oostmuur · foto 4 tot 6</span><span class="report__tag">Vloer · foto 12</span></span></div>
          <div class="report__row"><b>Woonkamer</b><span><span class="report__tag">Zuidmuur · foto 19 en 20</span><span class="report__tag">Plafond · foto 24</span></span></div>
          <div class="report__row"><b>Vaststelling</b><span>Plaatselijke krassen op de muur ter hoogte van de trap.</span></div>
          <div class="report__row"><b>Meters</b><span>Elektriciteit · gas · water: meternummer en stand</span></div>
          <div class="report__row"><b>Sleutels</b><span>Voordeur · achterdeur · garage en brievenbus</span></div>
        </div>
        <div class="split__media split__media--wide" style="margin-top:24px">
          <Photo src={detailImg} alt="Over de schouder van de plaatsbeschrijver: een tablet toont een foto van de keuken voor het verslag" width={720} height={480} sizes="(max-width: 860px) 92vw, 540px" />
        </div>
      </div>
    </div>
  </section>

  <Faq items={homeFaq} title="Vragen die we vaak krijgen" />

  <CtaBand />
</Base>
