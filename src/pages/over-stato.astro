---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { founderNode } from '../data/schema';

import portrait from '../assets/foto/pieter-wolfs-stato-buiten.jpg';
import workImg from '../assets/foto/plaatsbezoek-woonkamer-trap.jpg';

const portraitForSchema = await getImage({ src: portrait, width: 800, format: 'jpg' });
---
<Base
  title="Over STATO en oprichter Pieter Wolfs"
  description="Maak kennis met Pieter Wolfs, oprichter van STATO. Met oog voor detail en een snelle service maakt STATO plaatsbeschrijvingen in Limburg en Vlaams-Brabant."
  path="/over-stato"
  pageType="AboutPage"
  breadcrumbs={[{ name: 'Over STATO', path: '/over-stato' }]}
  schema={[{ ...founderNode, image: new URL(portraitForSchema.src, SITE.url).href }]}
>
  <section class="page-hero dark">
    <div class="container page-hero__grid">
      <div>
        <h1>Ik ben Pieter, oprichter van STATO en gebeten door vastgoed</h1>
        <p class="lead">Vanuit mijn interesse in de vastgoedwereld kwam ik steeds vaker in contact met vastgoedmakelaars en groeide mijn ervaring in het opmaken van plaatsbeschrijvingen. Al snel voelde ik: dit is wat ik graag doe. Daarom heb ik mij verder verdiept in het vak en ben ik STATO gestart.</p>
      </div>
      <div class="portrait">
        <Photo src={portrait} alt="Pieter Wolfs, oprichter van STATO, met een tablet aan een moderne woning met zwembad" width={560} height={760} position="center" sizes="(max-width: 900px) 92vw, 420px" priority />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Waarom STATO?</h2>
        <p>Ik zocht een naam die rust en duidelijkheid uitstraalt, zoals een goed verslag: overzichtelijk en correct opgesteld. Elk pand behandel ik met zorg, en ik probeer uw verslag zo snel mogelijk af te werken zonder dat de kwaliteit eronder lijdt.</p>
        <p>Ik werk graag samen met particulieren en vastgoedprofessionals en hoop een waardevolle bijdrage te leveren aan uw vastgoedverhaal.</p>
        <h2>Aan wiens kant sta ik?</h2>
        <p>Aan geen enkele. Bij een plaatsbeschrijving ben ik onafhankelijke vaststeller, niet de vertegenwoordiger van de huurder of de verhuurder. Het verslag beschrijft wat er is, los van wie er belang bij heeft. Wie de schade betaalt, regelen huurder en verhuurder onderling.</p>
        <div class="actions">
          <a class="btn btn--primary" href="/onze-diensten">Bekijk onze diensten</a>
          <a class="btn btn--outline" href="/vastgoedprofessionals">Voor vastgoedkantoren</a>
        </div>
      </div>
      <div>
        <div class="split__media split__media--tall">
          <Photo src={workImg} alt="Pieter Wolfs tijdens een plaatsbezoek in een woonkamer met zwevende trap" width={640} height={800} position="center" sizes="(max-width: 860px) 92vw, 540px" />
        </div>
        <div class="contact-card dark" style="margin-top:28px;color:#fff">
          <strong style="font-size:1.15rem">{SITE.founder}<br /><span style="font-weight:400;color:#cfcbea">{SITE.legalName}</span></strong>
          <a href={`tel:${SITE.phone}`} style="color:#fff"><span class="ico"><Icon name="phone" size={20} /></span>{SITE.phoneDisplay}</a>
          <a href={`mailto:${SITE.email}`} style="color:#fff"><span class="ico"><Icon name="mail" size={20} /></span>{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
