---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer). Ga naar de startpagina of bekijk onze diensten." path="/404" noindex>
  <section class="page-hero dark">
    <div class="container">
      <h1>Deze pagina vinden we niet terug</h1>
      <p class="lead">Misschien is de pagina verplaatst. Deze pagina's helpen u verder:</p>
      <div class="hero__actions">
        <a class="btn btn--gold" href="/">Startpagina</a>
        <a class="btn btn--ghost-light" href="/onze-diensten">Onze diensten</a>
        <a class="btn btn--ghost-light" href="/vrijblijvende-offerte">Offerte aanvragen</a>
      </div>
    </div>
  </section>
</Base>
