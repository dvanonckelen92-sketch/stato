<Base title="Bedankt voor uw aanvraag" description="Uw aanvraag is goed ontvangen. STATO neemt zo snel mogelijk contact met u op." path="/bedankt" noindex>
  <section class="page-hero dark">
    <div class="container">
      <h1>Bedankt voor uw aanvraag</h1>
      <p class="lead">We hebben uw bericht goed ontvangen en nemen zo snel mogelijk contact met u op.</p>
      <div class="hero__actions"><a class="btn btn--gold" href="/">Terug naar de startpagina</a></div>
    </div>
  </section>
</Base>
