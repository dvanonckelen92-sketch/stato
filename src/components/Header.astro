---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site';

interface Props {
  current: string;
}
const { current } = Astro.props;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="STATO, naar de startpagina">
      <Logo />
    </a>

    <nav class="nav" aria-label="Hoofdmenu">
      <ul class="nav__list">
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={`tel:${SITE.phone}`} aria-label={`Bel STATO op ${SITE.phoneDisplay}`}>
        <Icon name="phone" size={18} />
        <span>{SITE.phoneDisplay}</span>
      </a>
      <a class="btn btn--primary btn--sm" href="/vrijblijvende-offerte">Offerte aanvragen</a>
      <button class="menu-toggle" type="button" popovertarget="mobiel-menu" aria-label="Menu openen">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobiel-menu" class="mobile-menu" popover>
    <div class="mobile-menu__head">
      <Logo />
      <button type="button" class="mobile-menu__close" popovertarget="mobiel-menu" popovertargetaction="hide" aria-label="Menu sluiten">&times;</button>
    </div>
    <nav aria-label="Mobiel menu">
      <ul>
        <li><a href="/">Home</a></li>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href="/vrijblijvende-offerte">Vrijblijvende offerte</a></li>
      </ul>
    </nav>
    <a class="btn btn--primary btn--block" href={`tel:${SITE.phone}`}><Icon name="phone" size={18} /> Bel {SITE.phoneDisplay}</a>
  </div>
</header>
