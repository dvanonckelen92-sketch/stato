---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Weergavebreedte en -hoogte; bepalen de beeldverhouding van de uitsnede. */
  width: number;
  height: number;
  sizes: string;
  priority?: boolean;
  position?: string;
}
const { src, alt, width, height, sizes, priority = false, position = 'center' } = Astro.props;

// Alleen breedtes genereren die uit het origineel kunnen worden gesneden, nooit opschalen.
const ratio = height / width;
const maxWidth = Math.floor(Math.min(src.width, src.height / ratio));
const widths = [...new Set([360, 540, 720, 960, 1280, width].map((w) => Math.min(w, maxWidth)))].sort((a, b) => a - b);
const w = Math.min(width, maxWidth);
---
<Picture
  src={src}
  alt={alt}
  width={w}
  height={Math.round(w * ratio)}
  widths={widths}
  fit="cover"
  position={position}
  sizes={sizes}
  formats={['avif', 'webp']}
  priority={priority}
/>
